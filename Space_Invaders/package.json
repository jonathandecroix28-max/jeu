{
  "scripts": {
    "start": "parcel ./src/index.html",
    "build": "rm -rf build && parcel build -d build --public-url ./ --no-source-maps ./src/index.html",
    "zip": "rm -f bundle.zip && cd build && bestzip ../bundle.zip *",
    "bundle": "yarn build && yarn zip",
    "tests": "npx tsc tests.ts --esModuleInterop --module commonjs && node tests.js",
    "lint": "npx eslint ."
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "bestzip": "^2.2.0",
    "eslint-config-google": "^0.14.0",
    "parcel-bundler": "^1.12.5",
    "sass": "^1.39.0",
    "typescript": "^4.4.2"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "node-forge": "^1.3.0",
    "postcss": "^8.4.31",
    "terser": "^4.8.1"
  }
}